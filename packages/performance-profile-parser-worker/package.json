{
  "name": "performance-profile-parser-worker",
  "version": "0.0.0-dev",
  "description": "Chromium performance trace parser worker",
  "type": "module",
  "main": "src/performanceProfileParserWorkerMain.ts",
  "private": true,
  "scripts": {
    "test": "node --unhandled-rejections=warn --experimental-vm-modules ../../node_modules/jest/bin/jest.js --detectOpenHandles --forceExit"
  },
  "jest": {
    "collectCoverage": true,
    "collectCoverageFrom": [
      "src/parts/ParsePerformanceProfile/**/*.ts"
    ],
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "injectGlobals": false,
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "testMatch": [
      "**/test/**"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    }
  },
  "dependencies": {
    "@lvce-editor/rpc": "^6.18.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12"
  }
}
